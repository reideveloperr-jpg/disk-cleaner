// Volchay Cleans — Windows resource file.
#include <windows.h>

IDI_ICON1 ICON DISCARDABLE "app.ico"

#define MANIFEST_ID 1
MANIFEST_ID 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Volchay"
            VALUE "FileDescription",  "Volchay Cleans"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "VolchayCleans"
            VALUE "OriginalFilename", "VolchayCleans.exe"
            VALUE "ProductName",      "Volchay Cleans"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
